generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code      String   @unique(map: "uk_organizations_code") @db.VarChar(64)
  name      String   @db.VarChar(128)
  status    String   @default("ACTIVE") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  tasks     Task[]

  @@map("organizations")
}

model User {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  username    String?     @unique(map: "uk_users_username") @db.VarChar(64)
  displayName String      @map("display_name") @db.VarChar(64)
  mobile      String?     @unique(map: "uk_users_mobile") @db.VarChar(32)
  email       String?     @unique(map: "uk_users_email") @db.VarChar(128)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  role        String      @default("EXECUTOR") @db.VarChar(32)
  status      String      @default("ACTIVE") @db.VarChar(32)
  fundProductId BigInt?   @map("fund_product_id") @db.UnsignedBigInt
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  tasks       Task[]      @relation("TaskCreatedBy")
  claims      TaskClaim[]
  pointAccount UserPointAccount?
  pointLedgers PointLedger[]
  sentTaskReminders TaskReminder[] @relation("TaskReminderSender")
  receivedTaskReminders TaskReminder[] @relation("TaskReminderRecipient")
  taskStatusHistories TaskStatusHistory[] @relation("TaskStatusHistoryOperator")
  claimStatusHistories ClaimStatusHistory[] @relation("ClaimStatusHistoryOperator")
  taskReviews TaskReview[] @relation("TaskReviewReviewer")
  notifications Notification[] @relation("NotificationRecipient")
  auditLogs AuditLog[] @relation("AuditLogUser")
  executorAccounts ExecutorAccount[]
  fundTaskPosts FundTaskPost[]
  fundTasks FundTask[]
  fundProduct FundProduct? @relation(fields: [fundProductId], references: [id])

  @@map("users")
}

model AccountRole {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  username         String   @db.VarChar(64)
  roleCode         String   @map("role_code") @db.VarChar(32)
  organizationName String?  @map("organization_name") @db.VarChar(128)
  status           String   @default("ACTIVE") @db.VarChar(32)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([username, roleCode], map: "uk_account_roles_username_role")
  @@index([username, status], map: "idx_account_roles_username_status")
  @@index([organizationName, status], map: "idx_account_roles_organization_status")
  @@map("account_roles")
}

model FundProduct {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code        String?  @unique(map: "uk_fund_products_code") @db.VarChar(64)
  name        String   @db.VarChar(128)
  productType String?  @map("product_type") @db.VarChar(64)
  riskLevel   String?  @map("risk_level") @db.VarChar(32)
  status      String   @default("ACTIVE") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  tasks       Task[]
  fundTaskPosts FundTaskPost[]
  fundTasks FundTask[]
  fundAccounts User[]

  @@map("fund_products")
}

model Task {
  id                     BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId         BigInt        @map("organization_id") @db.UnsignedBigInt
  fundProductId          BigInt?       @map("fund_product_id") @db.UnsignedBigInt
  fundProductName        String?       @map("fund_product_name") @db.VarChar(128)
  title                  String        @db.VarChar(160)
  taskKey                String?       @unique(map: "uk_tasks_business_key") @map("task_key") @db.VarChar(512)
  description            String?       @db.Text
  originalText           String?       @map("original_text") @db.LongText
  taskType               String        @map("task_type") @db.VarChar(64)
  platform               String        @db.VarChar(64)
  campaignName           String?       @map("campaign_name") @db.VarChar(128)
  status                 String        @default("DRAFT") @db.VarChar(32)
  quota                  Int           @default(0) @db.UnsignedInt
  rewardPoints           Int           @default(10) @map("reward_points") @db.UnsignedInt
  claimedCount           Int           @default(0) @map("claimed_count") @db.UnsignedInt
  approvedCount          Int           @default(0) @map("approved_count") @db.UnsignedInt
  submitRequirements     Json?         @map("submit_requirements")
  claimRules             Json?         @map("claim_rules")
  complianceRequirements String?       @map("compliance_requirements") @db.Text
  dueAt                  DateTime      @map("due_at") @db.DateTime(3)
  publishedAt            DateTime?     @map("published_at") @db.DateTime(3)
  closedAt               DateTime?     @map("closed_at") @db.DateTime(3)
  createdBy              BigInt        @map("created_by") @db.UnsignedBigInt
  updatedBy              BigInt?       @map("updated_by") @db.UnsignedBigInt
  version                Int           @default(1) @db.UnsignedInt
  createdAt              DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  organization           Organization  @relation(fields: [organizationId], references: [id])
  fundProduct            FundProduct?  @relation(fields: [fundProductId], references: [id])
  creator                User          @relation("TaskCreatedBy", fields: [createdBy], references: [id])
  claims                 TaskClaim[]
  submissions            TaskSubmission[]
  reminders              TaskReminder[]
  statusHistory          TaskStatusHistory[]
  claimStatusHistory     ClaimStatusHistory[]
  reviews                TaskReview[]
  fundTaskPostId         BigInt?       @map("fund_task_post_id") @db.UnsignedBigInt
  fundTaskPost            FundTaskPost? @relation(fields: [fundTaskPostId], references: [id])
  fundTaskId              BigInt?       @map("fund_task_id") @db.UnsignedBigInt
  fundTask                FundTask?     @relation(fields: [fundTaskId], references: [id])

  @@index([status, dueAt], map: "idx_tasks_status_due_at")
  @@index([organizationId, status], map: "idx_tasks_organization_status")
  @@index([platform, status], map: "idx_tasks_platform_status")
  @@index([fundTaskPostId], map: "idx_tasks_fund_task_post")
  @@index([fundTaskId], map: "idx_tasks_fund_task")
  @@map("tasks")
}

model ExecutorAccount {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt   @map("user_id") @db.UnsignedBigInt
  platform    String   @db.VarChar(64)
  accountName String   @map("account_name") @db.VarChar(128)
  accountUid  String?  @map("account_uid") @db.VarChar(128)
  passwordEncrypted String? @map("password_encrypted") @db.Text
  status      String   @default("ACTIVE") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user        User     @relation(fields: [userId], references: [id])
  claims      TaskClaim[]

  @@index([userId, status], map: "idx_executor_accounts_user_status")
  @@map("executor_accounts")
}

model FundTaskPost {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  fundProductId BigInt    @map("fund_product_id") @db.UnsignedBigInt
  createdBy   BigInt      @map("created_by") @db.UnsignedBigInt
  taskName    String      @map("task_name") @db.VarChar(160)
  platform    String      @db.VarChar(64)
  postKey     String?     @unique(map: "uk_fund_task_posts_business_key") @map("post_key") @db.VarChar(512)
  postTitle  String?      @map("post_title") @db.VarChar(255)
  postContent String?     @map("post_content") @db.LongText
  postUrl    String?      @map("post_url") @db.VarChar(1024)
  status      String      @default("ACTIVE") @db.VarChar(32)
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  fundProduct FundProduct @relation(fields: [fundProductId], references: [id])
  creator     User        @relation(fields: [createdBy], references: [id])
  tasks       Task[]
  claims      TaskClaim[]
  fundTaskId  BigInt?     @map("fund_task_id") @db.UnsignedBigInt
  fundTask    FundTask?   @relation(fields: [fundTaskId], references: [id])

  @@index([fundProductId, taskName], map: "idx_fund_task_posts_product_task")
  @@map("fund_task_posts")
}

model FundTask {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  fundProductId BigInt        @map("fund_product_id") @db.UnsignedBigInt
  createdBy     BigInt        @map("created_by") @db.UnsignedBigInt
  taskName      String        @map("task_name") @db.VarChar(160)
  platform      String        @db.VarChar(64)
  status        String        @default("ACTIVE") @db.VarChar(32)
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  fundProduct   FundProduct   @relation(fields: [fundProductId], references: [id])
  creator       User          @relation(fields: [createdBy], references: [id])
  posts         FundTaskPost[]
  tasks         Task[]

  @@index([fundProductId, taskName], map: "idx_fund_tasks_product_task")
  @@map("fund_tasks")
}

model TaskClaim {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  taskId      BigInt           @map("task_id") @db.UnsignedBigInt
  fundTaskPostId BigInt?       @map("fund_task_post_id") @db.UnsignedBigInt
  userId      BigInt           @map("user_id") @db.UnsignedBigInt
  status      String           @default("PENDING_SUBMIT") @db.VarChar(32)
  activeFlag  Int?             @default(1) @map("active_flag") @db.UnsignedTinyInt
  claimedAt   DateTime         @default(now()) @map("claimed_at") @db.DateTime(3)
  submittedAt DateTime?        @map("submitted_at") @db.DateTime(3)
  reviewedAt  DateTime?        @map("reviewed_at") @db.DateTime(3)
  reviewerId  BigInt?          @map("reviewer_id") @db.UnsignedBigInt
  version     Int              @default(1) @db.UnsignedInt
  rewardPoints Int?            @map("reward_points") @db.UnsignedInt
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  task        Task             @relation(fields: [taskId], references: [id])
  fundTaskPost FundTaskPost?   @relation(fields: [fundTaskPostId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  executorAccountId BigInt?    @map("executor_account_id") @db.UnsignedBigInt
  assignedPostTitle String?    @map("assigned_post_title") @db.VarChar(255)
  assignedPostContent String?  @map("assigned_post_content") @db.LongText
  assignedPostUrl String?      @map("assigned_post_url") @db.VarChar(1024)
  executorAccount ExecutorAccount? @relation(fields: [executorAccountId], references: [id])
  submissions TaskSubmission[]
  statusHistory ClaimStatusHistory[]
  reviews TaskReview[]

  @@unique([taskId, executorAccountId, activeFlag], map: "uk_task_claims_task_account_active")
  @@unique([fundTaskPostId, activeFlag], map: "uk_task_claims_post_active")
  @@index([taskId, status], map: "idx_task_claims_task_status")
  @@index([userId, status], map: "idx_task_claims_user_status")
  @@index([executorAccountId, status], map: "idx_task_claims_account_status")
  @@map("task_claims")
}

model TaskSubmission {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  taskId        BigInt    @map("task_id") @db.UnsignedBigInt
  claimId       BigInt    @map("claim_id") @db.UnsignedBigInt
  userId        BigInt    @map("user_id") @db.UnsignedBigInt
  submitVersion Int       @default(1) @map("submit_version") @db.UnsignedInt
  content       Json?
  textContent   String?   @map("text_content") @db.Text
  linkUrl       String?   @map("link_url") @db.VarChar(1024)
  status        String    @default("PENDING_REVIEW") @db.VarChar(32)
  reviewComment String?   @map("review_comment") @db.Text
  reviewedAt    DateTime? @map("reviewed_at") @db.DateTime(3)
  reviewedBy    BigInt?   @map("reviewed_by") @db.UnsignedBigInt
  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  task          Task      @relation(fields: [taskId], references: [id])
  claim         TaskClaim @relation(fields: [claimId], references: [id])
  review        TaskReview?

  @@index([claimId, createdAt], map: "idx_task_submissions_claim_created_at")
  @@index([taskId, status], map: "idx_task_submissions_task_status")
  @@map("task_submissions")
}

model TaskReminder {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  taskId      BigInt   @map("task_id") @db.UnsignedBigInt
  senderId    BigInt   @map("sender_id") @db.UnsignedBigInt
  recipientId BigInt?  @map("recipient_id") @db.UnsignedBigInt
  message     String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  task        Task     @relation(fields: [taskId], references: [id])
  sender      User     @relation("TaskReminderSender", fields: [senderId], references: [id])
  recipient   User?    @relation("TaskReminderRecipient", fields: [recipientId], references: [id])

  @@index([taskId, createdAt], map: "idx_task_reminders_task_created_at")
  @@index([recipientId, createdAt], map: "idx_task_reminders_recipient_created_at")
  @@map("task_reminders")
}

model UserPointAccount {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt   @unique(map: "uk_point_accounts_user") @map("user_id") @db.UnsignedBigInt
  availablePoints Int      @default(0) @map("available_points") @db.Int
  frozenPoints    Int      @default(0) @map("frozen_points") @db.Int
  withdrawnPoints Int      @default(0) @map("withdrawn_points") @db.Int
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user            User     @relation(fields: [userId], references: [id])

  @@map("user_point_accounts")
}

model PointLedger {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt   @map("user_id") @db.UnsignedBigInt
  taskId       BigInt?  @map("task_id") @db.UnsignedBigInt
  claimId      BigInt?  @map("claim_id") @db.UnsignedBigInt
  entryType    String   @map("entry_type") @db.VarChar(32)
  points       Int      @db.Int
  balanceAfter Int      @map("balance_after") @db.Int
  remark       String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], map: "idx_point_ledgers_user_created_at")
  @@index([taskId, entryType], map: "idx_point_ledgers_task_type")
  @@map("point_ledgers")
}

model TaskStatusHistory {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  taskId     BigInt   @map("task_id") @db.UnsignedBigInt
  fromStatus String?  @map("from_status") @db.VarChar(32)
  toStatus   String   @map("to_status") @db.VarChar(32)
  action     String   @db.VarChar(64)
  reason     String?  @db.VarChar(1000)
  operatorId BigInt?  @map("operator_id") @db.UnsignedBigInt
  source     String   @default("WEB") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  task       Task     @relation(fields: [taskId], references: [id])
  operator   User?    @relation("TaskStatusHistoryOperator", fields: [operatorId], references: [id])

  @@index([taskId, createdAt], map: "idx_task_status_history_task_created_at")
  @@index([operatorId, createdAt], map: "idx_task_status_history_operator_created_at")
  @@map("task_status_history")
}

model ClaimStatusHistory {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  claimId    BigInt    @map("claim_id") @db.UnsignedBigInt
  taskId     BigInt    @map("task_id") @db.UnsignedBigInt
  fromStatus String?   @map("from_status") @db.VarChar(32)
  toStatus   String    @map("to_status") @db.VarChar(32)
  action     String    @db.VarChar(64)
  reason     String?   @db.VarChar(1000)
  operatorId BigInt?   @map("operator_id") @db.UnsignedBigInt
  source     String    @default("WEB") @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  claim      TaskClaim @relation(fields: [claimId], references: [id])
  task       Task      @relation(fields: [taskId], references: [id])
  operator   User?     @relation("ClaimStatusHistoryOperator", fields: [operatorId], references: [id])

  @@index([claimId, createdAt], map: "idx_claim_status_history_claim_created_at")
  @@index([taskId, createdAt], map: "idx_claim_status_history_task_created_at")
  @@map("claim_status_history")
}

model TaskReview {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  taskId       BigInt         @map("task_id") @db.UnsignedBigInt
  claimId      BigInt         @map("claim_id") @db.UnsignedBigInt
  submissionId BigInt         @unique(map: "uk_task_reviews_submission") @map("submission_id") @db.UnsignedBigInt
  reviewerId   BigInt         @map("reviewer_id") @db.UnsignedBigInt
  result       String         @db.VarChar(32)
  reason       String?        @db.VarChar(1000)
  reviewedAt   DateTime       @default(now()) @map("reviewed_at") @db.DateTime(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  task         Task           @relation(fields: [taskId], references: [id])
  claim        TaskClaim      @relation(fields: [claimId], references: [id])
  submission   TaskSubmission @relation(fields: [submissionId], references: [id])
  reviewer     User           @relation("TaskReviewReviewer", fields: [reviewerId], references: [id])

  @@index([taskId, result], map: "idx_task_reviews_task_result")
  @@index([claimId, createdAt], map: "idx_task_reviews_claim_created_at")
  @@index([reviewerId, createdAt], map: "idx_task_reviews_reviewer_created_at")
  @@map("task_reviews")
}

model Notification {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  recipientId  BigInt    @map("recipient_id") @db.UnsignedBigInt
  eventId      BigInt?   @map("event_id") @db.UnsignedBigInt
  templateCode String    @map("template_code") @db.VarChar(64)
  title        String    @db.VarChar(160)
  content      String?   @db.Text
  status       String    @default("UNREAD") @db.VarChar(32)
  readAt       DateTime? @map("read_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  recipient    User      @relation("NotificationRecipient", fields: [recipientId], references: [id])

  @@unique([eventId, recipientId, templateCode], map: "uk_notifications_event_recipient_template")
  @@index([recipientId, readAt, createdAt], map: "idx_notifications_recipient_read_created")
  @@index([status, createdAt], map: "idx_notifications_status_created_at")
  @@map("notifications")
}

model AuditLog {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt?   @map("user_id") @db.UnsignedBigInt
  roleCode      String?   @map("role_code") @db.VarChar(32)
  action        String    @db.VarChar(64)
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   BigInt    @map("aggregate_id") @db.UnsignedBigInt
  requestId     String?   @map("request_id") @db.VarChar(64)
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  details       Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user          User?     @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([aggregateType, aggregateId, createdAt], map: "idx_audit_logs_aggregate_created")
  @@index([userId, createdAt], map: "idx_audit_logs_user_created")
  @@index([action, createdAt], map: "idx_audit_logs_action_created")
  @@map("audit_logs")
}

model DomainEvent {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  eventType     String    @map("event_type") @db.VarChar(64)
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   BigInt    @map("aggregate_id") @db.UnsignedBigInt
  payload       Json?
  status        String    @default("PENDING") @db.VarChar(32)
  retryCount    Int       @default(0) @map("retry_count") @db.UnsignedInt
  nextRetryAt   DateTime? @map("next_retry_at") @db.DateTime(3)
  processedAt   DateTime? @map("processed_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([status, nextRetryAt], map: "idx_domain_events_status_retry")
  @@index([aggregateType, aggregateId], map: "idx_domain_events_aggregate")
  @@index([createdAt], map: "idx_domain_events_created_at")
  @@map("domain_events")
}
